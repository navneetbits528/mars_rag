# Copy to .env and add your own API key. Never commit .env.
OPENAI_API_KEY=
FAST_MODEL=gpt-4o-mini
MAIN_MODEL=gpt-4o-mini
DEEP_MODEL=
JUDGE_MODEL=gpt-4o-mini
EMBED_MODEL=text-embedding-3-small
EMBED_DIM=1536
DATABASE_URL=postgresql://marsrag:marsrag_dev_password@localhost:5432/marsrag
ADMIN_API_KEY=change-this-demo-admin-key
OPENAI_MAX_REQUESTS=10
DAILY_COST_LIMIT_USD=2.00
MAX_RETRIES=2
RETRY_BASE_SECONDS=0.5
REQUEST_TIMEOUT_SECONDS=30
MODEL_CONTEXT_LIMIT=128000
INPUT_PRICE_PER_1M_USD=0.15
OUTPUT_PRICE_PER_1M_USD=0.60
EMBEDDING_PRICE_PER_1M_USD=0.02
PROMPT_VERSION=v1
CORPUS_VERSION=1
LOG_LEVEL=INFO

# Phase 2 ingestion. Large batches help stay within the 10-request demo budget.
EMBEDDING_BATCH_TOKEN_LIMIT=150000
EMBEDDING_BATCH_ITEM_LIMIT=2048
CHUNK_SIZE_CHARS=1000
CHUNK_OVERLAP_RATIO=0.15
MIN_CHUNK_CHARS=80

# Semantic answer cache
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_TTL_SECONDS=86400
SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.93
